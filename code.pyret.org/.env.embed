GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_API_KEY=""
GOOGLE_SERVER_API_KEY=""
GOOGLE_APP_ID=""
BASE_URL="."
CURRENT_PYRET_RELEASE=""
# The gzipped bundle, fetched + inflated in-page (PYRET_GZIPPED): the static
# hosts that serve this artifact send no Content-Encoding, and shipping the
# gz bytes keeps the embed payload ~3MB instead of ~20MB.
PYRET="./js/cpo-main.jarr.gz.js"
PYRET_GZIPPED="true"
# TypeScript-compiler flavor (opt-in via ?compiler=ts on the embed URL --
# see editor.html; the embed library's `compiler` config option sets it).
# Its asset URLs are derived from PYRET's directory (editor.html), so there
# is nothing to configure; the gz ts artifacts sit next to the bundle when
# the embed build ran `npm run build:ts`.
CPO_COMPILER="pyret"
POSTMESSAGE_ORIGIN="*"
SHARED_FETCH_SERVER="https://code.pyret.org"
APP_NAME=code.pyret.org
APP_DOMAIN=code.pyret.org
URL_FILE_MODE="all-remote"
IMAGE_PROXY_BYPASS="true"
